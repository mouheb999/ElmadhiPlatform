# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payment webhook (Konnect/Flouci later). HMAC-SHA256 key, not a bearer token:
# callers send `x-webhook-signature: t=<unix-seconds>,v1=<hex>` where the digest
# covers `${t}.${rawBody}`, and requests older than 5 minutes are refused.
# Unset = the endpoint returns 503 and grants nothing.
PAYMENT_WEBHOOK_SECRET=

# Telegram — where a new payment request, an uploaded receipt, or a customer
# message on a payment thread gets announced. Same bot as the landing site's
# waitlist notifier, so copy both values from landingPlatform/.env.local.
# TELEGRAM_CHAT_ID takes one id or a comma-separated list ("123456,789012") so
# several people get pinged. Unset = no notifications; nothing else changes,
# and no request is ever failed because a notification could not be sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public site URL (used for auth redirects). MUST be set to the real origin in
# production: unset, sign-up confirmation links fall back to the request's Host
# header, which the caller controls.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI meal estimation. With no model key set, the grounded USDA fallback runs
# (real macros, but no photo recognition).
ANTHROPIC_API_KEY=

# Gemini — currently the test provider. Get a key at aistudio.google.com.
# WARNING: on Google's FREE tier, submitted content is used to train their
# models and may be seen by human reviewers. Tunisia is outside the
# EEA/UK/Swiss carve-out, so do NOT point real users' meal photos at a free
# key — enable billing first. Testing with your own photos is fine.
GEMINI_API_KEY=
# NOT gemini-2.5-*: those 404 with "no longer available to new users" on new
# keys. Verified working: gemini-3.6-flash, gemini-3.5-flash-lite,
# gemini-3.1-flash-lite, gemini-flash-latest.
GEMINI_MODEL=gemini-3.6-flash

# Which model answers: "gemini" | "claude". Unset prefers Claude when its key
# is present, else Gemini.
MEAL_AI_PROVIDER=gemini

# USDA FoodData Central — free macro lookups that ground the estimate.
# Unset falls back to DEMO_KEY (30 req/hour, no signup). Get a real key in
# seconds at https://fdc.nal.usda.gov/api-key-signup for 1,000 req/hour.
USDA_FDC_API_KEY=
